# 只配置在服务器端；不要使用 VITE_ 前缀。
NOVELAI_TOKEN=
NOVELAI_IMAGE_URL=https://image.novelai.net
PORT=6006
HOST=0.0.0.0
# 外层反代的公开访问地址，需包含协议及非默认端口；直连时可留空。
PUBLIC_ORIGIN=
ACCOUNTS_FILE=
SETTINGS_FILE=
PROMPTS_FILE=
# V5 额度低于此百分比时停止发送生成请求，最小值为 1。
NOVELAI_MIN_USAGE_PERCENT=1
# 可选：如果已确认上游价格查询接口，配置其完整 URL。
# 返回 { "price": 数字 } 或 { "cost": 数字 }。普通用户及未开启积分的管理员仅允许 0。
NOVELAI_PRICE_URL=
